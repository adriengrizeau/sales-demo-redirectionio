# Clé du projet redirection.io (écran « Instances » > « Setup on your infrastructure »)
REDIRECTIONIO_TOKEN=
# Nom affiché dans l'écran Instances du manager
REDIRECTIONIO_INSTANCE_NAME=vercel-sales-demo
# Ajoute l'en-tête X-RedirectionIo-RuleIds aux réponses (pratique en démo)
REDIRECTIONIO_ADD_HEADER_RULE_IDS=true
